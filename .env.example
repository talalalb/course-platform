# Copy this file to .env and adjust the values.

# PostgreSQL connection string
DATABASE_URL=postgres://course:course@127.0.0.1:5432/course_platform

# Public address of the site (used to build invitation links)
APP_URL=http://localhost:3000

# Folder where uploaded files are stored (keep it outside the web root and back it up)
STORAGE_DIR=./storage

# Time zone used to show and enter deadlines
APP_TIMEZONE=Asia/Riyadh

# "production" disables the demo seed script. Cookies are marked Secure when APP_URL starts with https://
APP_ENV=development

# Used only by `npm run create-admin`
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# Used by docker-compose.yml only
DB_PASSWORD=
